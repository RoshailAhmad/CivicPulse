# Backend settings when running uvicorn directly on your laptop (Part 1).
# Copy to backend/.env. Uses 127.0.0.1 because Postgres/Redis are published
# to your machine by compose.deps.yaml. Inside containers these become the
# service names (database, cache) — set by Compose, never hardcoded.
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://civicpulse:change-me@127.0.0.1:5432/civicpulse
REDIS_URL=redis://127.0.0.1:6379/0
TRIAGE_PROVIDER=rules
LLM_API_KEY=
