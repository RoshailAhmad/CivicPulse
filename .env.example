# Copy to .env and fill in real values. .env is gitignored — never commit it.
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me

# rules | simulated | llm | ollama
TRIAGE_PROVIDER=rules
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2:1b
RATE_LIMIT_PER_MINUTE=10

# compose.prod.yaml only: the commit SHA of the images to run
IMAGE_TAG=
